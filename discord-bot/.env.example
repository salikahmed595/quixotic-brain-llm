DISCORD_TOKEN=YOUR_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_APPLICATION_ID
DISCORD_GUILD_ID=YOUR_TEST_SERVER_ID
# Only index within these explicitly approved ticket channels or their child threads.
ALLOWED_CHANNEL_IDS=YOUR_TICKET_PARENT_CHANNEL_ID
# At least one role that can invoke the sales commands. Users also need Discord channel permissions.
STAFF_ROLE_IDS=YOUR_SALES_STAFF_ROLE_ID
# Compatible with OpenAI /v1/chat/completions or an internal OpenAI-compatible Office SLM gateway.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=YOUR_AI_API_KEY
AI_MODEL=YOUR_APPROVED_MODEL
DB_PATH=./data/copilot.sqlite
# Initial backfill stops after this many batches (100 messages each); dashboard will warn if incomplete.
MAX_SYNC_PAGES=100
# Optional: maximum LLM output tokens
MAX_OUTPUT_TOKENS=450
