# =====================================================================================================================
# Quixotic AI — configuration template. Copy to `.env` (never commit `.env`; it is git-ignored) and fill in every value
# marked  >>> FILL IN <<<. Comments go on their own lines, never after a value.
#
# Rule (CLAUDE.md): values the PRD does not specify have NO hidden default in code. The app refuses to start until every
# required value is set, and prints which ones are missing. Every choice below is explained in docs/PRD_GAPS.md.
# Generate random secrets with:   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Local development: the values below already work with `docker compose up -d postgres` + `python scripts/dev_up.py`.
# Production (one EC2 server): see docs/DEPLOYMENT.md — docker-compose.prod.yml overrides the database, queue and vault paths.
# =====================================================================================================================


# ---------------------------------------------------------------------------------------------------------------------
# 1. Your web address and secrets  (PRD §5, §10)
# ---------------------------------------------------------------------------------------------------------------------
# The address people open. https:// in production (cookies are then Secure); http://localhost:8000 locally.
QB_PUBLIC_URL=http://localhost:8000
# Production only: the domain Caddy gets an HTTPS certificate for (DNS must point at the server). >>> FILL IN <<<
QB_DOMAIN=
# Signs service-to-service tokens. >= 32 random characters. >>> FILL IN (production) <<<
QB_SESSION_SECRET=change-me-change-me-change-me-change-me
# Encrypts admin MFA secrets at rest. >= 32 random characters; never change it after people enrolled MFA. >>> FILL IN (production) <<<
QB_FIELD_ENCRYPTION_KEY=change-me-too-change-me-too-change-me-too
# How long a sign-in lasts, in seconds (PRD gives no number; 8 h shown).
QB_SESSION_TTL_SECONDS=28800
# How long email verification / password reset links work, in seconds (PRD gives no number; 24 h shown).
QB_ONE_TIME_LINK_TTL_SECONDS=86400
# PRD §5 FR-AUTH-06 admin MFA (authenticator app). Keep true in production; false only on a developer laptop.
QB_ADMIN_MFA_REQUIRED=true


# ---------------------------------------------------------------------------------------------------------------------
# 2. Email  (PRD §5 FR-AUTH-02 verification, FR-AUTH-06 password reset, approval notices)
# ---------------------------------------------------------------------------------------------------------------------
# smtp = real email (Amazon SES, Google Workspace, Microsoft 365, ...). console = local development: links go to the log.
QB_MAIL_BACKEND=console
# Required for smtp. >>> FILL IN (production) <<<
# QB_MAIL_FROM=Quixotic AI <no-reply@your-company.com>
# QB_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# QB_SMTP_PORT=587
# QB_SMTP_USERNAME=
# QB_SMTP_PASSWORD=
# QB_SMTP_STARTTLS=true
# Port 465 servers (e.g. Hostinger: smtp.hostinger.com) use direct SSL instead of STARTTLS:
# QB_SMTP_SSL=true


# ---------------------------------------------------------------------------------------------------------------------
# 3. Database, job queue and file storage  (PRD §8, §11)
# ---------------------------------------------------------------------------------------------------------------------
# Production: docker-compose.prod.yml builds QB_DATABASE_URL from these three. >>> FILL IN (production) <<<
POSTGRES_USER=quixotic
POSTGRES_PASSWORD=quixotic
POSTGRES_DB=quixotic_brain
# Local: the docker-compose.yml database.
QB_DATABASE_URL=postgresql://quixotic:quixotic@localhost:5432/quixotic_brain
# PRD §11 "Redis and worker queue". Production (EC2): redis (set by docker-compose.prod.yml). Local: sqs (the moto stand-in).
QB_QUEUE_BACKEND=sqs
# QB_REDIS_URL=redis://localhost:6379/0
QB_SQS_QUEUE_URL=http://localhost:5000/123456789012/quixotic-brain-jobs
# Private object storage for uploaded originals (S3). >>> FILL IN (production): your bucket and region <<<
QB_S3_BUCKET=quixotic-brain-dev
QB_AWS_REGION=us-east-1
# Local only: the moto stand-in (scripts/dev_up.py starts it on :5000). Remove these four lines in AWS.
QB_S3_ENDPOINT_URL=http://localhost:5000
QB_SQS_ENDPOINT_URL=http://localhost:5000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_DEFAULT_REGION=us-east-1
# Local only: keep uploaded originals in a folder instead of S3.
QB_RAW_STORAGE_DIR=.devstore
# In AWS the EC2 instance role gives S3 access; do not put real AWS keys in this file.


# ---------------------------------------------------------------------------------------------------------------------
# 4. Knowledge  (PRD §8, §10)
# ---------------------------------------------------------------------------------------------------------------------
# The Git-versioned Markdown vault (approved knowledge). Production: /srv/vault/work (set by docker-compose.prod.yml).
QB_VAULT_DIR=.devvault
# Who may see which access level (PRD §8 "sensitivity", §10). JSON {level: [roles]}. Roles: employee, department_reviewer,
# knowledge_admin, system_admin, founder_ceo.  >>> REVIEW: these three levels are a PROPOSAL — tell us your real levels <<<
QB_SENSITIVITY_LEVELS_JSON={"internal":["employee","department_reviewer","knowledge_admin","system_admin","founder_ceo"],"confidential":["department_reviewer","knowledge_admin","system_admin","founder_ceo"],"restricted":["system_admin","founder_ceo"]}
# Largest upload in bytes (50 MB).
QB_MAX_UPLOAD_BYTES=52428800
# How documents are cut into searchable passages (characters).
QB_CHUNK_SIZE=1000
QB_CHUNK_OVERLAP=150
# Knowledge priority by document type (optional JSON, e.g. {"policy":1,"sop":2}); {} = not used.
QB_PRIORITY_TIERS_JSON={}


# ---------------------------------------------------------------------------------------------------------------------
# 5. Search and the answer model  (PRD §8, §10, §11)
# ---------------------------------------------------------------------------------------------------------------------
# Hybrid search: candidates searched (20-40) and passages used (5-8).
QB_CANDIDATE_COUNT=30
QB_FINAL_CHUNK_COUNT=5
QB_RERANK_TOP_K=3
QB_RERANK_SKIP_MARGIN=0.04
QB_HISTORICAL_TOP_K=10
# Overload protection: seconds a request may wait for the search models before "busy, try again" (503). Commented out = no limit,
# but then an overload can stall every user. Size it with the AT-09 load test (e.g. 10). >>> REVIEW <<<
# QB_MODEL_QUEUE_TIMEOUT_SECONDS=10
# Owner addition "Translate for client" (Urdu / Roman Urdu -> client-ready English): departments that get it. Empty = off.
QB_TRANSLATE_DEPARTMENTS=Sales - Upseller,Sales - Fresh Seller
QB_ROMAN_URDU_MIN_RATIO=0.5
# Confidence thresholds (measured on a sample; re-calibrate on your documents with evaluation/run_eval.py).
QB_CONFIDENCE_HIGH=0.3
QB_CONFIDENCE_MEDIUM=0.01
QB_CONFIDENCE_VECTOR_HIGH=0.65
QB_CONFIDENCE_VECTOR_MEDIUM=0.55
# Embedding model and reranker (CPU). Downloaded on first start (~4.6 GB).
QB_EMBEDDING_PROVIDER=bge-m3
QB_EMBEDDING_MODEL_PATH=BAAI/bge-m3
QB_RERANKER_PROVIDER=cross-encoder
QB_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# The answer model (PRD §8: DeepSeek or another configured LLM; owner 2026-10-17: OpenAI now, DeepSeek later).
# PRD §10: only send company data to a provider the company has approved.
QB_GENERATION_PROVIDER=openai
# >>> FILL IN: the model id, e.g. gpt-4o-mini (OpenAI) or deepseek-chat (DeepSeek) <<<
QB_GENERATION_MODEL_ID=
# Optional, OpenAI gpt-5 / o-series only: minimal | low | medium | high (unset = model default; measured: low was not faster for gpt-5-nano)
# QB_GENERATION_REASONING_EFFORT=
# Required only for the claude provider:
# QB_GENERATION_MAX_TOKENS=
# >>> FILL IN: the key of the provider you chose (only that one) <<<
OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Restate Urdu / Roman Urdu questions as an English search query (one small extra AI call).
QB_QUERY_INTERPRETATION=true
# Learn from thumbs up / down (search order and personal style only; never edits knowledge).
QB_FEEDBACK_LEARNING=true
# Answers from past sales chats: OFF (owner, 2026-10-17).
QB_SALES_HISTORY_ENABLED=false


# ---------------------------------------------------------------------------------------------------------------------
# 6. Web app
# ---------------------------------------------------------------------------------------------------------------------
QB_FRONTEND_DIR=web/dist
# Only if the web app is hosted on another address:
# QB_CORS_ORIGINS=https://app.your-company.com


# ---------------------------------------------------------------------------------------------------------------------
# 7. OPTIONAL — Hermes + Telegram + Obsidian  (PRD §9; docs/HERMES_TELEGRAM_OBSIDIAN_PLAN.md). Leave empty to keep it off.
# ---------------------------------------------------------------------------------------------------------------------
# Bot 2 "Quixotic Approvals" from @BotFather (confirmations and approvals; owned by this backend). >>> FILL IN to enable <<<
QB_TELEGRAM_BOT_TOKEN=
# Random >= 32 characters; checked on every Telegram webhook call. >>> FILL IN to enable <<<
QB_TELEGRAM_WEBHOOK_SECRET=
# Random >= 32 characters, shared with the quixotic-mcp sidecar and the vault Git hook. >>> FILL IN to enable Hermes <<<
QB_HERMES_SHARED_SECRET=
# The bearer token Hermes uses to reach quixotic-mcp (same value in /srv/hermes/.env). >>> FILL IN to enable Hermes <<<
QUIXOTIC_MCP_TOKEN=
# Optional: the Telegram user id of the one person who talks to the Hermes bot (they still confirm every proposal).
QUIXOTIC_DEFAULT_TELEGRAM_USER=
# Obsidian contributors: one private Git repository per person (deploy/vault/setup-vault-git.sh sets /srv/vault/contributors;
# locally scripts/obsidian_local.py). Empty = Obsidian sync off. Each person sees only the published notes their account may see.
QB_VAULT_CONTRIBUTORS_DIR=
# Optional backup mirror of the approved vault (server only; never give contributors access to it). Empty = none.
QB_VAULT_REMOTE=
