# Quixotic Brain backend configuration. All variables are prefixed QB_.
# Values the PRD/stack do not specify have no default in code; the numbers below are PLACEHOLDERS to be
# reviewed by the product owner and tuned with the evaluation set (PRD §58–§59). See docs/PRD_GAPS.md.
# Copy to .env (git-ignored). Keep comments on their own lines, never after a value.

# --- infrastructure: RDS PostgreSQL + pgvector, S3, SQS ---
# Local: docker compose up -d postgres (same user/password/database as docker-compose.yml)
QB_DATABASE_URL=postgresql://quixotic:quixotic@localhost:5432/quixotic_brain
QB_S3_BUCKET=quixotic-brain-dev
QB_SQS_QUEUE_URL=http://localhost:5000/123456789012/quixotic-brain-jobs
QB_AWS_REGION=us-east-1
# Local dev uses moto as an S3 + SQS stand-in (scripts/dev_up.py starts it on :5000). Remove the lines below in AWS.
QB_S3_ENDPOINT_URL=http://localhost:5000
QB_SQS_ENDPOINT_URL=http://localhost:5000
# Dummy credentials for the local moto stand-in only. In AWS the task role provides real credentials.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_DEFAULT_REGION=us-east-1
# Local development only: keep uploaded originals in a folder instead of the in-memory S3 emulator
QB_RAW_STORAGE_DIR=.devstore

# --- auth: JWT (HS256). In AWS, inject from Secrets Manager. ---
# Must be >= 32 characters. Generate one: python -c "import secrets; print(secrets.token_hex(24))"
QB_SESSION_SECRET=change-me-change-me-change-me-change-me
# PLACEHOLDER
QB_SESSION_TTL_SECONDS=28800

# --- ingestion ---
# PLACEHOLDER (50 MB, from the UI mock-up)
QB_MAX_UPLOAD_BYTES=52428800
# PLACEHOLDERS (characters)
QB_CHUNK_SIZE=1000
QB_CHUNK_OVERLAP=150

# --- retrieval: pgvector + keyword (BM25-equivalent) hybrid, then rerank ---
# PRD range 20–40
QB_CANDIDATE_COUNT=30
# PRD range 5–8 (5 = less for the AI to read, fewer irrelevant sources)
QB_FINAL_CHUNK_COUNT=5
# candidates the reranker reads (~0.5 s each on CPU)
QB_RERANK_TOP_K=3
# skip the reranker when top-1 clearly leads top-2 (measured: ~54% of questions, same quality). 0 = never skip
QB_RERANK_SKIP_MARGIN=0.04
# PLACEHOLDER
QB_HISTORICAL_TOP_K=10
# PLACEHOLDER
QB_ROMAN_URDU_MIN_RATIO=0.5

# --- confidence labels (High / Medium / Low). TWO signals, the better counts. PLACEHOLDERS measured on a 56-question sample:
#     reranker probability (HIGH/MEDIUM) and vector cosine similarity (VECTOR_HIGH/VECTOR_MEDIUM). Re-calibrate on real documents. ---
QB_CONFIDENCE_HIGH=0.3
QB_CONFIDENCE_MEDIUM=0.01
QB_CONFIDENCE_VECTOR_HIGH=0.65
QB_CONFIDENCE_VECTOR_MEDIUM=0.55

# --- models (CPU) ---
# Hugging Face ids download on first use (~4.6 GB, cached). Or point at local folders, e.g. .models/bge-m3
# after running scripts/download_models.sh.
QB_EMBEDDING_PROVIDER=bge-m3
QB_EMBEDDING_MODEL_PATH=BAAI/bge-m3
QB_RERANKER_PROVIDER=cross-encoder
# multilingual BGE reranker
QB_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- generation: deepseek | openai | gemini | claude | bedrock. PRD default is deepseek; owner (2026-10-17): openai until the DeepSeek key is added. Pick a model id yourself. ---
# Without a model id and key the app still starts; asking a question then reports "answer model not configured".
QB_GENERATION_PROVIDER=openai
QB_GENERATION_MODEL_ID=
# Required only for claude:
# QB_GENERATION_MAX_TOKENS=
# API keys use the SDKs' standard variables (inject from AWS Secrets Manager in ECS):
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- knowledge priority (PRD §20): document_type -> tier 1..3 (4 = historical sales) ---
QB_PRIORITY_TIERS_JSON={}

# --- front-end hosting ---
# Serve the static front-end from the API at http://localhost:8000/ (remove if the front-end is hosted elsewhere)
QB_FRONTEND_DIR=web/dist
# Comma-separated; only if the front-end is hosted elsewhere:
# QB_CORS_ORIGINS=https://your-app.vercel.app

# --- Urdu / Roman Urdu: restate such questions as an English search query with one small AI call (PRD §23). Needs the answer-model key. ---
QB_QUERY_INTERPRETATION=true

# Past sales chats: OFF (owner, 2026-10-17). Answers come only from approved knowledge. While false, nothing below has effect.
QB_SALES_HISTORY_ENABLED=false
# Only used if the switch above is turned on: minimum similarity for a past chat to be used.
# QB_SALES_HISTORY_MIN_SIMILARITY=0.55
