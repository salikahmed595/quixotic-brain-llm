{
  "manifest_version": 3,
  "name": "Quixotic Reply Assistant",
  "version": "0.1.0",
  "description": "Reads the open Discord chat only when you click, and shows a private Quixotic AI reply draft to copy. Never sends.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://maqsad.quixoticcreatives.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Quixotic Reply Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*"
      ],
      "js": [
        "reader.js",
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
