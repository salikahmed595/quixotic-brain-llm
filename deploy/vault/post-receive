#!/bin/bash
# Tells the Quixotic API that notes were pushed to a proposals branch; they become proposals for review.
# Signed like every Hermes call: HMAC-SHA256(QB_HERMES_SHARED_SECRET, "<timestamp>.<body>"). The backend's own pushes are skipped.
[ "${QUIXOTIC_BACKEND:-}" = "1" ] && exit 0
# shellcheck disable=SC1091
. /srv/vault/hooks.env        # QUIXOTIC_API_URL=..., QB_HERMES_SHARED_SECRET=...
while read -r old new ref; do
  case "$ref" in refs/heads/proposals/*) ;; *) continue ;; esac
  branch="${ref#refs/heads/}"
  body=$(printf '{"branch":"%s","commit":"%s"}' "$branch" "$new")
  ts=$(date +%s)
  sig=$(printf '%s.%s' "$ts" "$body" | openssl dgst -sha256 -hmac "$QB_HERMES_SHARED_SECRET" | sed 's/^.* //')
  if curl -fsS -m 60 -X POST "$QUIXOTIC_API_URL/v1/integrations/vault/push" -H "Content-Type: application/json" \
       -H "X-Quixotic-Timestamp: $ts" -H "X-Quixotic-Signature: $sig" --data "$body" >/dev/null; then
    echo "Quixotic AI: your notes were sent for review."
  else
    echo "Quixotic AI: could not reach the server right now; your notes are saved. Push again later."
  fi
done
