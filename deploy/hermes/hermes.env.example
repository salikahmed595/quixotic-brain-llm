# Hermes Agent secrets (copied to the Hermes data folder as .env; never commit the real file). docs/HERMES_TELEGRAM_OBSIDIAN_PLAN.md
# Bot 1 "Quixotic Hermes" from @BotFather (NOT the approvals bot):
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ids allowed to talk to Hermes, comma-separated (CEO, Founder, Knowledge Admins):
TELEGRAM_ALLOWED_USERS=
# The answer model Hermes thinks with (needs >= 64k context):
OPENAI_API_KEY=
# Speech-to-text for voice notes (owner decision: OpenAI):
VOICE_TOOLS_OPENAI_KEY=
# Same value as QUIXOTIC_MCP_TOKEN of the quixotic-mcp service:
QUIXOTIC_MCP_TOKEN=
