DISCORD_TOKEN=YOUR_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_APPLICATION_ID
DISCORD_GUILD_ID=YOUR_TEST_SERVER_ID
# Only work within these explicitly approved ticket channels or their child threads.
ALLOWED_CHANNEL_IDS=YOUR_TICKET_PARENT_CHANNEL_ID
# At least one role that can invoke the sales commands. Users also need Discord channel permissions.
STAFF_ROLE_IDS=YOUR_SALES_STAFF_ROLE_ID
# Quixotic AI (the bot never calls an LLM directly). The API key needs the 'ask' permission.
QUIXOTIC_API_URL=https://YOUR_QUIXOTIC_AI_HOST
QUIXOTIC_API_KEY=YOUR_QUIXOTIC_API_KEY
# JSON map: Discord staff user ID -> Quixotic AI employee user_id. Unmapped staff are refused.
STAFF_USER_MAP={"DISCORD_USER_ID":"QUIXOTIC_USER_ID"}
