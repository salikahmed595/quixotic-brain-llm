{
  "manifest_version": 3,
  "name": "Quixotic Reply Assistant",
  "version": "0.1.0",
  "description": "Reads the chat open in this tab only when you click (Discord, Twitch, X, or any site where you highlight it) and shows a private Quixotic AI reply draft to copy. Never sends.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://maqsad.quixoticcreatives.com/*",
    "https://discord.com/*",
    "https://www.twitch.tv/*",
    "https://dashboard.twitch.tv/*",
    "https://x.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Quixotic Reply Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
